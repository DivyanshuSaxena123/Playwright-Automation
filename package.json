{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test ./tests/WebAPIPart1.spec.js --headed",
    "test:debug": "npx playwright test ./tests/WebAPIPart1.spec.js --debug",
    "test:all": "npx playwright test",
    "regression": "npx playwright test",
    "ciTests": "npx playwright test --grep '@CI'",
    "safariNewConfig": "npx playwright test --config playwright.config1.js --project=safari",
    "CucumberRegression": "npx cucumber-js --tags '@Regression' --retry 1 --exit --format html:cucumber-reporrt.html"
  },
