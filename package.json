    "@types/node": "^25.6.0",
    "allure-playwright": "^3.9.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "exceljs": "^4.4.0"
  }
